{
  "name": "img-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Free image tools that run in your browser: convert HEIC to JPG, compress, resize, remove EXIF, make passport photos. Nothing is uploaded.",
  "keywords": [
    "image converter",
    "image compressor",
    "heic to jpg",
    "webp to jpg",
    "exif remover",
    "passport photo",
    "resize image",
    "image tools",
    "client-side",
    "privacy",
    "offline",
    "webassembly",
    "sveltekit",
    "svelte"
  ],
  "homepage": "https://img-tools.fyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/yexner/img-tools.git"
  },
  "bugs": {
    "url": "https://github.com/yexner/img-tools/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/licenses.ts && node scripts/llms-txt.ts && vite build && node scripts/check-build.ts",
    "preview": "vite preview",
    "check": "prettier --check . && svelte-kit sync && svelte-check --fail-on-warnings && node scripts/source-scan.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@jsquash/avif": "2.1.1",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/webp": "1.5.0",
    "@tabler/icons": "3.49.0",
    "blurhash": "2.0.5",
    "exifr": "7.1.3",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "libheif-js": "1.23.5",
    "mediabunny": "1.62.1",
    "pdfjs-dist": "6.4.299",
    "svgo": "4.1.0",
    "utif2": "4.1.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#tools/*": "./src/tools/*"
  },
  "overrides": {
    "svgo": {
      "sax": "1.4.1"
    }
  }
}
